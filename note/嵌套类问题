 *
 * [726] Number of Atoms
 */

// 嵌套类问题就是用一个where来代表当前位置， 遇到子问题（内层嵌套）就递归，更新where
#include <vector>
#include <string>
#include <map>
using namespace std;
// @lc code=start
class Solution {
public:
    int where; //代表当前处理到哪一个地方了
    void fill(map<string , int>& ans , string& name , map<string , int>& pre, int count)
    {
         if(name.empty() && pre.empty()) return; // 没有结算元素，自然没有结算单元
         if(count == 0) count = 1;               // 默认 count = 1
         
         if(!name.empty()) ans[name] += count;    // 有name 就累加
         else for(const auto& [k , v] : pre) ans[k] += v * count; // 有括号就累加count个括号 
    }
    // 结算元素 ：name：原子名称， pre：括号内部结果
    // 结算单元 ：{结算元素：个数}
    // 遇到括号或者大写字母，就应该结算所有的结算单元 
    map<string , int> f(string& s , int i)
    {
        int cnt = 0;
        string name;
        map<string , int> ans;
        map<string , int> pre;
        while(i < s.length() && s[i] != ')') // 遇到右括号停止
        {
            if(s[i] >= 'A' && s[i] <= 'Z' || s[i] == '(') 
            {
                fill(ans, name , pre , cnt);
                cnt = 0;
                pre.clear();
                name.clear();
                if(s[i] >= 'A' && s[i] <= 'Z')
                {
                    name += s[i++]; // 累积结算单元
                }
                else // '('
                {
                    pre = f(s , i+1); //遇到左括号处理下一个括号内不，处理方式相同，属于子问题，因此递归 累积解算单元
                    i = where + 1; // 递归结束后，从结束位置的下一个开始处理剩下的
                } 
            } 
            else if(s[i] >= '0' && s[i] <= '9')
            {
                cnt = cnt * 10 + (s[i++] - '0'); // 计算个数
            }
            else
            {
                name += s[i++];
            }
        }
        fill(ans , name, pre , cnt);
        where = i; // 更新当前位置
        return ans;
    }
    string countOfAtoms(string formula) {
       where = 0;
       map<string , int> result; 
       string ans;
       result = f(formula , 0);
       for(const auto& [k , v] : result)
       {
          ans += k; 
          int count = result[k];
          if(count > 1)
          {
             ans += to_string(count);
          }
       }
       return ans;
    }
};
// @lc code=end



